# Merged on top of `make tinyconfig`. Just enough to boot an initramfs under QEMU
# and exercise the pidmon syscall.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_MULTIUSER=y
# RLIMIT_CPU handling in the kernel lives in posix-cpu-timers
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
# pid-namespace test
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
# faster/cleaner guest under KVM
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
# per-task I/O accounting (rchar/wchar/read_bytes/write_bytes in pidmon_usage);
# TASKSTATS is the only way to reach TASK_XACCT and needs the networking core
CONFIG_NET=y
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y
